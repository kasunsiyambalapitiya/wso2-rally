# Copy to config.env and source it, or export these in your shell / Choreo config.
# Load() fails at startup naming any required key that is missing.

# HTTP listener port.
PORT=8080

# MySQL DSN. Required.
# parseTime=true is needed for time.Time scanning; multiStatements=true for golang-migrate.
DB_DSN=rally:rally@tcp(localhost:3306)/rally?parseTime=true&multiStatements=true

# HMAC secret signing participant (team) JWTs. Required. Rotate per event.
TEAM_TOKEN_SECRET=change-me-in-choreo

# How long a team token stays valid. Go duration syntax. Default 12h.
TEAM_TOKEN_TTL=12h

# Asgardeo JWKS endpoint. Required unless TOKEN_VALIDATOR_ENABLED=false.
JWKS_ENDPOINT=https://api.asgardeo.io/t/<org>/oauth2/jwks

# Organizer token signature validation. Defaults to ON; only the literal
# "false" turns it off. This file ships the local-dev opt-out because there is
# no Asgardeo tenant to call from a laptop — never carry that value further.
TOKEN_VALIDATOR_ENABLED=false

# Group claim that grants organizer admin actions.
ADMIN_ROLE=rally-admin

# Dev-only CORS origin. Leave empty in Choreo, where the gateway owns CORS.
CORS_ALLOW_ORIGIN=http://localhost:3000

# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
